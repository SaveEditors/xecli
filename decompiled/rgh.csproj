<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <AssemblyName>rgh</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>Exe</OutputType>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.7</Version>
    <FileVersion>1.0.7.0</FileVersion>
    <AssemblyVersion>1.0.7.0</AssemblyVersion>
    <InformationalVersion>1.0.7</InformationalVersion>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup />
  <ItemGroup />
  <ItemGroup>
    <Reference Include="Spectre.Console">
      <HintPath>..\Spectre.Console.dll</HintPath>
    </Reference>
    <Reference Include="Spectre.Console.Cli">
      <HintPath>..\Spectre.Console.Cli.dll</HintPath>
    </Reference>
    <Reference Include="Xbox360.Remote">
      <HintPath>..\Xbox360.Remote.dll</HintPath>
    </Reference>
    <Reference Include="FluentFTP">
      <HintPath>..\FluentFTP.dll</HintPath>
    </Reference>
    <Reference Include="SharpCompress">
      <HintPath>..\SharpCompress.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\src\Xbox360.Fatx\Xbox360.Fatx.csproj" />
    <PackageReference Include="System.Management" Version="10.0.0-preview.3.25171.5" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Localization\LocalizedDescriptionAttribute.cs" Link="Localization\LocalizedDescriptionAttribute.cs" />
    <Compile Include="..\Localization\LocalizedText.cs" Link="Localization\LocalizedText.cs" />
    <Compile Include="..\Localization\LocalizedText.Catalog.g.cs" Link="Localization\LocalizedText.Catalog.g.cs" />
    <Compile Include="..\Localization\LocalizedConsole.cs" Link="Localization\LocalizedConsole.cs" />
    <Compile Include="..\src\Xbox360.Remote.Cli\Commands\FatmanCommands.cs" Link="Xbox360.Remote.Cli.Commands\FatmanCommands.cs" />
    <Compile Include="..\src\Xbox360.Remote.Cli\Commands\FatmanDiskCommands.cs" Link="Xbox360.Remote.Cli.Commands\FatmanDiskCommands.cs" />
    <Compile Include="..\src\Xbox360.Remote.Cli\Commands\FatmanMetadataCommands.cs" Link="Xbox360.Remote.Cli.Commands\FatmanMetadataCommands.cs" />
    <Compile Include="..\src\Xbox360.Remote.Cli\Commands\FatmanRepairCommands.cs" Link="Xbox360.Remote.Cli.Commands\FatmanRepairCommands.cs" />
    <Compile Include="..\src\Xbox360.Remote.Cli\Fatman\FatmanWindowsStorage.cs" Link="Xbox360.Remote.Cli.Fatman\FatmanWindowsStorage.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\Assets\**\*">
      <Link>Assets\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
